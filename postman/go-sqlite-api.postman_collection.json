    },
    {
      "name": "Update Feature",
      "request": {
        "method": "PUT",
        "url": "http://localhost:8080/api/features/{{feature_id}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"dark-mode\",\n  \"value\": false,\n  \"resourceId\": \"ui-settings\",\n  \"active\": false\n}"
        }
      }
    },
    {
      "name": "Delete Feature",
      "request": {
        "method": "DELETE",
        "url": "http://localhost:8080/api/features/{{feature_id}}",
